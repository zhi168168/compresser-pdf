# Vercel Functions + Neon. Secrets belong only in Production server env.
# Local tooling: copy to ignored .env.local. Never use a VITE_ secret.
NODE_ENV=production
SITE_URL=https://your-site.example
PUBLIC_SITE_URL=https://your-site.example
BETTER_AUTH_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://user:replace-password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional direct connection, used only for controlled migrations.
# DIRECT_DATABASE_URL=postgresql://user:replace-password@your-project.region.aws.neon.tech/neondb?sslmode=require

# Set both. Callback: https://your-site.example/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Required for verified email registration/password reset; host/from and user/pass pairs.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Compresser PDF <accounts@your-site.example>

# Optional standalone Docker/service only, not required on Vercel + Neon.
# PORT=3001
# POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
# TRUSTED_PROXY_SECRET=another-random-secret-at-least-32-characters
# Local Vite development proxy:
# ACCOUNT_DEV_PROXY=http://127.0.0.1:3001
